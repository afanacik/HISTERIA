{
  "manifest_version": 3,
  "name": "Кит — ГрамФикс + ВК-инструменты",
  "short_name": "Кит",
  "version": "2.6.0",
  "description": "Всё в одном: звуковой сигнал и галочка на вкладке, когда ChatGPT ответил, AI-правка текста (исправить · сформулировать · перевести), шаблоны ВК с группами и вложениями (фото, PDF), «невидимка» (не помечать прочитанным, скрывать онлайн, скрывать «печатает…») и умный фикс битой статики ВК (перезапись URL + CORS + сторож с журналом).",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "declarativeNetRequest",
    "webRequest",
    "offscreen",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Кит",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/gramfix.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content/vk-shard-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content/vk-shard-rewrite.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content/vk-stealth-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content/vk-stealth.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://vk.com/*",
        "https://*.vk.com/*",
        "https://vk.ru/*",
        "https://*.vk.ru/*"
      ],
      "js": [
        "content/vk-templates.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/gpt-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content/gpt-sounds.js",
        "content/gpt-signal.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
